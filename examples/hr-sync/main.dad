# Users, department groups and managers driven by an HR export (people.csv).
# Leavers (active = no) are disabled and moved to a Leavers OU instead of being deleted.

connection {
  server   = "dc01.corp.local"
  domain   = "corp.local"
  username = "svc-declarad@corp.local"
}

variable "initial_password" {
  type      = string
  sensitive = true
}

variable "mail_domain" {
  type    = string
  default = "corp.example"
}

locals {
  rows        = csvdecode(file("${path.module}/people.csv"))
  people      = { for r in local.rows : r.sam => r }
  departments = toset([for r in local.rows : r.department])
  by_dept     = { for r in local.rows : r.department => r.sam... if r.active == "yes" }
  offices     = toset([for r in local.rows : r.office])
}

ou "people" {
  name = "People"
}

ou "office" {
  for_each = local.offices
  name     = each.key
  path     = ou.people.dn
}

ou "leavers" {
  name        = "Leavers"
  description = "Disabled accounts, kept for 90 days"
}

user "person" {
  for_each = local.people

  sam_account_name = each.key
  given_name       = each.value.first_name
  surname          = each.value.last_name
  title            = each.value.title
  department       = each.value.department
  office           = each.value.office
  email            = "${each.key}@${var.mail_domain}"
  manager          = each.value.manager == "" ? null : user.person[each.value.manager].dn

  enabled = each.value.active == "yes"
  path    = each.value.active == "yes" ? ou.office[each.value.office].dn : ou.leavers.dn

  initial_password         = var.initial_password
  change_password_at_logon = true

  lifecycle {
    ignore_changes = [phone, mobile]

    precondition {
      condition     = each.value.manager == "" || contains(keys(local.people), each.value.manager)
      error_message = "Unknown manager '${each.value.manager}' for ${each.key}."
    }
  }
}

group "department" {
  for_each    = local.departments
  name        = "Dept ${each.key}"
  path        = ou.people.dn
  description = "Generated from people.csv"
  members     = [for sam in lookup(local.by_dept, each.key, []) : user.person[sam].dn]
}

group "managers" {
  name    = "People Managers"
  path    = ou.people.dn
  members = distinct([for r in local.rows : user.person[r.manager].dn if r.manager != "" && r.active == "yes"])
}

output "headcount" {
  value = { for dept, sams in local.by_dept : dept => length(sams) }
}
